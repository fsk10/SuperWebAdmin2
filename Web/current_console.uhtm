<iframe class="console-log" src="%LogURI%#END" title="Console log"></iframe>
<form method="post" action="/current_console" class="console-send">
  <input type="text" name="SendText" value="%SendText%" placeholder="Message to all players, or /command" aria-label="Message or command" autofocus autocomplete="off">
  <input type="submit" name="Send" value="Send" class="primary">
</form>
%ConsoleMessage%
<p class="hint">Text is sent to all players as a chat message. Start with / for a command: /mutate ... (Server admin and up) or any console command (Super admin).</p>
