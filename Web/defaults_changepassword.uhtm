<form class="block" method="post" action="%PostAction%">
  <input type="hidden" name="GameType" value="%GameType%">
  <table>
    <tr>
      <td>Username</td>
      <td>%Username%</td>
    </tr>
    
    
    
    
    <tr>
      <td>New Password</td>
      <td><input type="password" name="NewPassword" maxlength="20" size="20" value="%NewPassword%"></td>
    </tr>
    <tr>
      <td>Confirm Password</td>
      <td><input type="password" name="ConfNewPassword" maxlength="20" size="20" value="%ConfNewPassword%"></td>
    </tr>
    
    <tr align="right"><td colspan="5"><input type="submit" name="Apply" value="Apply" class="primary"></td></tr>
  </table>
</form>
